/* === УТИЛИТЫ И ПЕРЕХОДЫ ЭКРАНОВ === */
.hidden {
    display: none;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: var(--time-screen);
    transition-timing-function: ease-out;
}

.screen--hidden-top {
    opacity: 0;
    translate: 0 -80px;
}

.screen--hidden-bottom {
    opacity: 0;
    translate: 0 80px;
}

/* === ПОДСКАЗКИ УПРАВЛЕНИЯ (SETTINGS + LOAD GAME) === */
.control-hints {
    position: absolute;
    right: 36px;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
}

.hint-item {
    flex-direction: row;
    align-items: center;
    margin-left: 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.hint-icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Спрайты KeyTip назначишь в UI Builder */
.hint-icon-mouse { }
.hint-icon-esc { }

.hint-text {
    font-size: 16px;
    color: var(--color-hint-dark);
    margin: 0;
    padding: 0;
}
