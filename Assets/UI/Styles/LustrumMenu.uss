.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.screen--hidden-top {
    opacity: 0;
    translate: 0 -80px;
}

.screen--hidden-bottom {
    opacity: 0;
    translate: 0 80px;
}

.main-screen {
    width: 100%;
    height: 100%;
}

.main-sidebar {
    width: 784px;
    height: 100%;
    padding: 96px 0 28px 72px;
    flex-direction: column;
    flex-grow: 1;
    align-items: flex-start;
    justify-content: center;
    align-content: flex-start;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 136px;
}

.logo-box {
    width: 100%;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Assets/Frames/LustrumLogo.png?fileID=21300000&guid=9ee308a0ab98743879292c25d8a6ad19&type=3#LustrumLogo");
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: auto;
    align-items: flex-start;
    background-position-y: top 0;
    background-position-x: left 0;
    flex-basis: auto;
    align-content: auto;
    aspect-ratio: 3.389831;
}

.nav-list {
    margin-top: 84px;
    width: 100%;
    align-items: flex-start;
    flex-grow: 0;
    flex-shrink: 1;
    height: auto;
    left: auto;
    justify-content: flex-start;
    align-content: auto;
    margin-bottom: 0;
}

.menu-btn {
    height: 56px;
    margin: 0 0 8px 0;
    padding: 0 24px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(184, 180, 173);
    font-size: 40px;
    -unity-text-align: middle-left;
    transition-property: background-color, color;
    transition-duration: 0.12s;
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    margin-top: 4px;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 0;
    padding-right: 0;
    -unity-font-style: normal;
    width: 416px;
}

.menu-btn--spaced {
    margin-top: 24px;
    width: 416px;
    height: 56px;
}

.menu-btn:hover,
.menu-btn:focus {
    background-color: rgb(216, 36, 46);
    color: rgb(239, 236, 230);
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    font-size: 40px;
    padding-left: 24px;
    width: 416px;
    height: 56px;
}

.social-row {
    flex-direction: row;
    margin-top: 84px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-left: 24px;
    flex-grow: 0;
    flex-shrink: 1;
    align-items: flex-start;
    width: 100%;
    height: 48px;
}

.social-btn {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.12s;
    margin-top: 0;
    margin-right: 16px;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.social-btn:hover {
}

.social-discord {
    background-image: url("project://database/Assets/UI/Assets/Icons/Discord.png?fileID=-1658927225162452868&guid=0ef3cbae6666e4ae3917ca7e705d80f8&type=3#Discord_Default");
}

.social-discord:hover {
    background-image: url("project://database/Assets/UI/Assets/Icons/Discord.png?fileID=507802870&guid=0ef3cbae6666e4ae3917ca7e705d80f8&type=3#Discord_Hover");
}

.social-x {
    background-image: url("project://database/Assets/UI/Assets/Icons/X.png?fileID=3959922740387019359&guid=0c81aa90982614df69fa03cde5d4d417&type=3#X_Default");
}

.social-x:hover {
    background-image: url("project://database/Assets/UI/Assets/Icons/X.png?fileID=97614201824372231&guid=0c81aa90982614df69fa03cde5d4d417&type=3#X_Hover");
}

.footer-meta {
    margin-top: auto;
    margin-left: 24px;
    margin-bottom: 24px;
    align-items: flex-start;
}

.meta-text {
    font-size: 18px;
    color: rgb(184, 180, 173);
    margin: 0;
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/IBMPlexSansItalic%20SDF.asset?fileID=11400000&guid=54323076457f145848f307825a423876&type=2#IBMPlexSansItalic SDF");
    height: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.settings-stub {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}
