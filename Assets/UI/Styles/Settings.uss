@import url("project://database/Assets/UI/Styles/Variables.uss?fileID=7433441132597879392&guid=b19c46dac7a854646b2b38a97b4e7cdc&type=3#Variables");

.settings-screen {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.settings-title {
    font-size: 40px;
    color: var(--color-gray_1);
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    -unity-text-align: lower-center;
    margin: 0 0 24px 0;
    padding: 0;
    width: 100%;
    flex-grow: 0;
    justify-content: flex-end;
    height: 80px;
    margin-bottom: 56px;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: stretch;
    align-self: auto;
}

.tabs-bar {
    flex-direction: row;
    padding: 10px 12px;
    margin-bottom: 0;
    align-items: center;
    justify-content: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    height: 56px;
}

.tab-btn {
    height: 56px;
    margin: 0 4px;
    border-width: 0;
    border-radius: 0;
    color: var(--color-beige);
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    transition-property: background-color, color;
    transition-duration: var(--time-fast);
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 304px;
    -unity-font-style: normal;
    background-color: rgba(0, 0, 0, 0);
}

.tab-btn:hover {
    background-color: var(--color-red);
    color: var(--color-white_1);
}

.tab-btn--active,
.tab-btn--active:hover {
    color: var(--color-beige);
    width: 304px;
    height: 56px;
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    font-size: 40px;
    -unity-text-align: middle-center;
    background-color: var(--color-red-active);
}

.settings-body {
    flex-grow: 1;
    background-color: var(--color-bg-body);
    padding: 16px;
}

.tab-page {
    flex-grow: 1;
    flex-direction: column;
    padding-top: 40px;
    padding-bottom: 40px;
    padding-right: 0;
    padding-left: 0;
    align-items: center;
    justify-content: flex-start;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    padding: 0 24px;
    margin-bottom: 16px;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    background-color: var(--color-black_2);
    padding-right: 16px;
    padding-left: 16px;
    padding-bottom: 0;
    width: 1216px;
}

.setting-label {
    font-size: 28px;
    color: var(--color-white_2);
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    margin: 0;
    padding: 0;
    align-items: flex-start;
    justify-content: center;
    align-self: auto;
    flex-direction: row;
    -unity-text-align: middle-left;
    white-space: normal;
}

.lustrum-dropdown {
    width: 360px;
    margin: 0;
    height: 48px;
    justify-content: center;
    align-items: flex-end;
}

.lustrum-dropdown .unity-base-field__label {
    display: none;
    visibility: visible;
    opacity: 1;
}

.lustrum-dropdown .unity-base-popup-field__input {
    height: 48px;
    background-color: var(--color-gray_2);
    border-width: 1px;
    border-color: var(--color-cream);
    border-radius: 0;
    padding: 0 12px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-right: 16px;
    padding-left: 16px;
    border-top-color: var(--color-beige);
    border-right-color: var(--color-beige);
    border-bottom-color: var(--color-beige);
    border-left-color: var(--color-beige);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.lustrum-dropdown .unity-base-popup-field__text {
    color: var(--color-beige);
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.lustrum-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-beige);
}

.slider-group {
    flex-direction: row;
    align-items: center;
    width: 340px;
}

.lustrum-slider {
    flex-grow: 0;
    margin: 0 16px 0 0;
    width: 360px;
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.lustrum-slider .unity-base-field__label {
    display: none;
}

.lustrum-slider .unity-base-slider__tracker {
    height: 8px;
    background-color: var(--color-black_0);
    border-width: 0;
    margin-top: -4px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    align-items: flex-start;
    justify-content: center;
    align-content: flex-start;
    align-self: auto;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.lustrum-slider .unity-base-slider__fill {
    background-color: var(--color-gray_1);
    align-items: flex-start;
    justify-content: center;
    flex-grow: 0;
}

.lustrum-slider .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    margin-top: -12px;
    background-color: var(--color-black_0);
    border-width: 2px;
    border-color: var(--color-beige);
    border-radius: 0;
}

.slider-value {
    width: 40px;
    font-size: 24px;
    color: var(--color-beige);
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

.segmented-group {
    flex-direction: row;
    justify-content: space-between;
    width: 360px;
}

.seg-btn {
    width: 176px;
    height: 40px;
    margin: 0;
    padding: 0;
    background-color: var(--color-gray_2);
    border-width: 2px;
    border-color: var(--color-beige);
    border-radius: 0;
    color: var(--color-beige);
    font-size: 22px;
    transition-property: background-color, border-color, color;
    transition-duration: var(--time-fast);
}

.seg-btn:hover,
.seg-btn:focus {
    background-color: var(--color-gray_3);
    border-color: var(--color-red-hover-focused);
    color: var(--color-white_1);
}

.seg-btn--active,
.seg-btn--active:hover,
.seg-btn--active:focus {
    background-color: var(--color-red-active);
    border-color: var(--color-red-active);
    color: var(--color-white_1);
}

.settings-footer {
    flex-direction: row;
    justify-content: space-around;
    padding-top: 24px;
}

.action-text-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-cream);
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    padding: 6px 24px;
    transition-property: color;
    transition-duration: var(--time-fast);
}

.action-text-btn:hover {
    color: var(--color-accent);
}

.settings-top-container {
    flex-grow: 0;
    width: 100%;
    height: 192px;
}

.settings-mid-container {
    flex-grow: 0;
    width: 100%;
    height: 584px;
}

.settings-bot-container {
    flex-grow: 0;
    width: 100%;
    height: 56px;
    padding-right: 0;
    padding-left: 0;
    flex-direction: row;
    justify-content: center;
    padding-top: 0;
    padding-bottom: 0;
    align-items: stretch;
    align-content: auto;
}

.control-btn {
    height: 56px;
    margin: 0 4px;
    border-width: 1px;
    border-color: var(--color-cream);
    border-radius: 0;
    color: var(--color-beige);
    font-size: 40px;
    transition-property: background-color, border-color;
    transition-duration: var(--time-fast);
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    width: 304px;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.control-btn:hover {
    height: 56px;
    margin: 0 4px;
    border-width: 1px;
    border-color: var(--color-cream);
    border-radius: 0;
    color: var(--color-white_1);
    font-size: 40px;
    transition-property: background-color, border-color;
    transition-duration: var(--time-fast);
    -unity-font-definition: url("project://database/Assets/UI/Assets/Fonts/RodchenkoBold%20SDF.asset?fileID=11400000&guid=bbda2d78f2afa44338e007e346db838e&type=2#RodchenkoBold SDF");
    width: 304px;
    background-color: var(--color-red-hover-focused);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.lustrum-dropdown:hover .unity-base-popup-field__input {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: var(--color-red-hover-focused);
    border-right-color: var(--color-red-hover-focused);
    border-top-color: var(--color-red-hover-focused);
    border-bottom-color: var(--color-red-hover-focused);
}

.lustrum-dropdown:focus .unity-base-popup-field__input {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: var(--color-red-hover-focused);
    border-right-color: var(--color-red-hover-focused);
    border-top-color: var(--color-red-hover-focused);
    border-bottom-color: var(--color-red-hover-focused);
}

.lustrum-dropdown:hover .unity-base-popup-field__text {
    color: var(--color-white_1);
}

.lustrum-dropdown:focus .unity-base-popup-field__text {
    color: var(--color-white_1);
}

.lustrum-dropdown:hover .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-red-hover-focused);
}

.lustrum-dropdown:focus .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-red-hover-focused);
}

.lustrum-dropdown:active .unity-base-popup-field__input {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: var(--color-red-active);
    border-right-color: var(--color-red-active);
    border-top-color: var(--color-red-active);
    border-bottom-color: var(--color-red-active);
}

.lustrum-dropdown:active .unity-base-popup-field__text {
    color: var(--color-red-active);
}

.lustrum-dropdown:active .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-red-active);
    rotate: 180deg;
}

.lustrum-slider .unity-base-slider__dragger:hover {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--color-red);
    border-right-color: var(--color-red);
    border-bottom-color: var(--color-red);
    border-left-color: var(--color-red);
    background-color: var(--color-gray_3);
}

.lustrum-slider .unity-base-slider__dragger:focus {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--color-red);
    border-right-color: var(--color-red);
    border-bottom-color: var(--color-red);
    border-left-color: var(--color-red);
    background-color: var(--color-gray_3);
}

.lustrum-slider .unity-base-slider__drag-container:active .unity-base-slider__dragger {
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: var(--color-red);
    border-right-color: var(--color-red);
    border-bottom-color: var(--color-red);
    border-left-color: var(--color-red);
    background-color: var(--color-gray_3);
}

.lustrum-slider:focus .unity-base-slider__fill {
    background-color: var(--color-red-hover-focused);
}

.lustrum-slider:focus .unity-base-slider__dragger {
    border-color: var(--color-white_1);
}

.lustrum-slider.is-dragger-hover .unity-base-slider__fill {
    background-color: var(--color-red-hover-focused);
}

.lustrum-slider.is-dragger-active .unity-base-slider__fill {
    background-color: var(--color-red-active);
}

.lustrum-slider.is-dragger-hover .unity-base-slider__dragger {
    border-color: var(--color-white_1);
}

.lustrum-slider.is-dragger-active .unity-base-slider__dragger {
    border-color: var(--color-red-active);
}
